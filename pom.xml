<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.camunda.community</groupId>
    <artifactId>connector-cmis</artifactId>
    <!-- 1.1.0 rename the artefactid to connector-cmis -->
    <version>1.1.0</version>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>


        <!-- connector SDK version -->
        <version.connector>8.7.8</version.connector>
        <version.chemistry>1.1.0</version.chemistry>

        <version.opensagres>2.0.4</version.opensagres>
        <version.filestorage>2.2.0</version.filestorage>

        <!-- external libraries -->
        <version.assertj>3.27.3</version.assertj>
        <version.junit-jupiter>6.1.3</version.junit-jupiter>
        <version.mockito>5.16.1</version.mockito>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
    </properties>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version> <!-- Example: set your intended version -->
    </parent>


    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>io.camunda.connector</groupId>
            <artifactId>connector-core</artifactId>
            <version>${version.connector}</version>
            <scope>provided</scope>
        </dependency>


        <dependency>
            <groupId>io.camunda.filestorage</groupId>
            <artifactId>filestorage</artifactId>
            <version>${version.filestorage}</version>
        </dependency>

        <dependency>
            <groupId>org.apache.chemistry.opencmis</groupId>
            <artifactId>chemistry-opencmis-client-impl</artifactId>
            <version>${version.chemistry}</version>
        </dependency>

        <dependency>
            <groupId>io.camunda.connector</groupId>
            <artifactId>element-template-generator-core</artifactId>
            <version>${version.connector}</version>
        </dependency>

        <!-- test dependencies -->
        <dependency>
            <groupId>io.camunda.connector</groupId>
            <artifactId>connector-test</artifactId>
            <version>${version.connector}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${version.junit-jupiter}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${version.mockito}</version>
            <scope>test</scope>
        </dependency>


        <!-- for testing connectors locally in bundle with runtime -->
        <dependency>
            <groupId>io.camunda.connector</groupId>
            <artifactId>spring-boot-starter-camunda-connectors</artifactId>
            <version>${version.connector}</version>
            <scope>test</scope>
        </dependency>

        <!-- to generate the element-template -->
        <dependency>
            <groupId>io.camunda.community</groupId>
            <artifactId>zeebe-cherry-runtime</artifactId>
            <version>3.4.0</version>
            <scope>test</scope>
        </dependency>



    </dependencies>

    <build>
        <plugins>
            <!-- spring-boot-starter-parent auto-binds spring-boot-maven-plugin's "repackage" goal
                 to the package phase, which fat-ifies the main artifact and renames the original
                 thin jar to original-*.jar - independently of, and conflicting with, the
                 with-dependencies shade execution below. Disable it so the plain jar stays
                 untouched (own classes only). -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <!-- spring-boot-starter-parent also pre-configures an unnamed ("default")
                         execution of this same plugin bound to the package phase, which repackages
                         the main jar into a Spring-Boot-style fat jar. Disable it so it doesn't
                         fight with "with-dependencies" below and fat-ify the plain jar. -->
                    <execution>
                        <id>default</id>
                        <phase>none</phase>
                    </execution>
                    <!-- "with-dependencies": a convenience jar for local use (upload to a Connector
                         Runtime or Cherry instance by hand). Those hosts already provide Spring Boot
                         + the whole Camunda connector/client/FEEL stack, so this excludes all of that
                         by groupId - but keeps filestorage's own Google API client stack (gson,
                         guava, google-api-client, google-oauth-client, google-auth-library,
                         google-http-client*, google-api-services-drive, the v4 httpcomponents,
                         commons-codec, commons-logging) and this connector's own CMIS/SOAP stack
                         (chemistry-opencmis, Apache CXF, woodstox, xml-resolver, asm, xmlschema,
                         wsdl4j, neethi, jaxb), since the host does NOT supply any of those.
                         shadedArtifactAttached MUST stay true: with true, the shaded jar is attached
                         as a SEPARATE classified artifact and the main jar is left untouched; with
                         false, Shade instead REPLACES the main artifact's file with the fat jar
                         (verified on sibling connectors: that produced a bogus "original-*.jar"
                         backup and a bloated main jar - the opposite of what we want).
                         NOTE: a single blanket "*:*" exclude was tried first on sibling connectors
                         but also strips out the project's OWN compiled classes (Shade treats an
                         all-excluded artifact set as "make an empty jar", not "keep only the
                         project's own output") - excluding by explicit groupId avoids that trap. -->
                    <execution>
                        <id>with-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <shadedClassifierName>with-dependencies</shadedClassifierName>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <artifactSet>
                                <excludes>
                                    <!-- Camunda connector/client/FEEL stack -->
                                    <exclude>io.camunda.connector:*</exclude>
                                    <exclude>io.camunda:*</exclude>
                                    <exclude>org.camunda.feel:*</exclude>
                                    <exclude>org.camunda.bpm.model:*</exclude>
                                    <!-- Spring Boot / Spring Framework -->
                                    <exclude>org.springframework.boot:*</exclude>
                                    <exclude>org.springframework:*</exclude>
                                    <exclude>ch.qos.logback:*</exclude>
                                    <exclude>org.apache.logging.log4j:*</exclude>
                                    <exclude>org.slf4j:*</exclude>
                                    <exclude>org.apache.tomcat.embed:*</exclude>
                                    <exclude>io.micrometer:*</exclude>
                                    <exclude>org.hibernate.validator:*</exclude>
                                    <exclude>org.jboss.logging:*</exclude>
                                    <exclude>com.fasterxml:classmate</exclude>
                                    <exclude>org.yaml:*</exclude>
                                    <exclude>jakarta.annotation:*</exclude>
                                    <!-- gRPC / Netty (Zeebe gateway transport); also pulled in
                                         transitively and unused at runtime by filestorage's
                                         google-http-client, same as verified on the pdf connector -->
                                    <exclude>io.grpc:*</exclude>
                                    <exclude>io.netty:*</exclude>
                                    <exclude>io.opencensus:*</exclude>
                                    <exclude>com.google.protobuf:*</exclude>
                                    <exclude>com.google.api.grpc:*</exclude>
                                    <exclude>com.google.j2objc:*</exclude>
                                    <exclude>com.google.auto.value:*</exclude>
                                    <exclude>com.google.api:api-common</exclude>
                                    <exclude>javax.annotation:javax.annotation-api</exclude>
                                    <!-- Camunda's OWN http-client transport only (v5) - NOT the v4
                                         org.apache.httpcomponents (no suffix) that filestorage's
                                         google-api-client needs, which stays bundled. -->
                                    <exclude>org.apache.httpcomponents.client5:*</exclude>
                                    <exclude>org.apache.httpcomponents.core5:*</exclude>
                                    <!-- Jackson - except jackson-datatype-jsr310, which filestorage
                                         needs directly (jackson-datatype-jdk8 is
                                         element-template-generator-core tooling only, safe to drop). -->
                                    <exclude>com.fasterxml.jackson.core:*</exclude>
                                    <exclude>com.fasterxml.jackson.dataformat:*</exclude>
                                    <exclude>com.fasterxml.jackson.datatype:jackson-datatype-jdk8</exclude>
                                    <exclude>com.fasterxml.jackson.module:*</exclude>
                                    <exclude>com.fasterxml.uuid:*</exclude>
                                    <!-- Scala (FEEL engine) -->
                                    <exclude>org.scala-lang:*</exclude>
                                    <exclude>com.lihaoyi:*</exclude>
                                    <!-- Misc transitive libraries used only by the Camunda/Spring stack -->
                                    <exclude>com.auth0:*</exclude>
                                    <exclude>dev.failsafe:*</exclude>
                                    <exclude>jakarta.validation:*</exclude>
                                    <exclude>io.pebbletemplates:*</exclude>
                                    <exclude>net.steppschuh.markdowngenerator:*</exclude>
                                    <exclude>org.apache.commons:*</exclude>
                                    <exclude>org.bouncycastle:*</exclude>
                                    <exclude>org.codehaus.mojo:animal-sniffer-annotations</exclude>
                                    <exclude>org.unbescape:*</exclude>
                                    <exclude>uk.co.jemos.podam:*</exclude>
                                </excludes>
                            </artifactSet>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

    <repositories>


        <repository>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
            <id>connectors</id>
            <name>Connectors Repository</name>
            <url>https://artifacts.camunda.com/artifactory/connectors/</url>
        </repository>

        <repository>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
            <id>connectors-snapshots</id>
            <name>Connectors Snapshot Repository</name>
            <url>https://artifacts.camunda.com/artifactory/connectors-snapshots/</url>
        </repository>


    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>connectors</id>
            <name>Connectors Repository</name>
            <url>https://artifacts.camunda.com/artifactory/connectors/</url>
        </pluginRepository>

        <pluginRepository>
            <id>connectors-snapshots</id>
            <name>Connectors Snapshot Repository</name>
            <url>https://artifacts.camunda.com/artifactory/connectors-snapshots/</url>
        </pluginRepository>
    </pluginRepositories>

    <profiles>
        <!-- This project has no .github/workflows release pipeline today, so this profile is never
             activated automatically. It's added anyway so that if/when a release pipeline is added
             using the standard community-action-maven-release action (its default release-profile
             id - see involvedusers' deploy.yml for the working reference), the with-dependencies
             shade execution is already correctly scoped out of the Central release from day one. -->
        <profile>
            <id>community-action-maven-release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>with-dependencies</id>
                                <phase>none</phase>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <phase>none</phase>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <phase>none</phase>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>


</project>
